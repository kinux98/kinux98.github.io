<header class="portfolio-site-header">
  <a class="portfolio-skip" href="#main-content">Skip to main content</a>
  <nav id="navbar" class="portfolio-nav" aria-label="Primary navigation">
    <div class="portfolio-nav__inner">
      <a class="portfolio-brand" href="{{ '/' | relative_url }}" aria-label="Donghyeon Kwon — Home">
        <span class="portfolio-brand__mark" aria-hidden="true">DK<span>.</span></span>
        <span class="portfolio-brand__copy">
          Donghyeon Kwon
          <small>Research Portfolio</small>
        </span>
      </a>
      <div class="portfolio-nav__links">
        <a href="#about">About</a>
        <a href="#publications">Publications</a>
        <a href="#updates">News</a>
        <a href="#experience">Background</a>
        <a href="#service">Service</a>
      </div>
      <div class="portfolio-nav__actions">
        <a class="portfolio-nav__cv" href="{{ '/assets/pdf/Donghyeon_Kwon_CV.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer">CV ↗</a>
        {% if site.enable_darkmode %}
          <button id="light-toggle" class="portfolio-nav__theme" type="button" title="Change color theme" aria-label="Change color theme">
            <i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
            <i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i>
            <i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i>
          </button>
        {% endif %}
        <details class="portfolio-mobile-nav">
          <summary>Menu</summary>
          <div class="portfolio-mobile-nav__panel">
            <a href="#about">About</a>
            <a href="#publications">Publications</a>
            <a href="#updates">News</a>
            <a href="#experience">Background</a>
            <a href="#service">Service</a>
            <a href="{{ '/assets/pdf/Donghyeon_Kwon_CV.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer">Curriculum Vitae ↗</a>
          </div>
        </details>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <div class="progress-container"><span class="progress-bar"></span></div>
    </progress>
  {% endif %}
</header>
