{% assign items = site.news | sort: 'date' | reverse %}
{% assign item_limit = include.limit | default: items.size %}
<ol class="news-list">
  {% for item in items limit: item_limit %}
    <li>
      <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
      <div class="news-copy">
        {% if item.inline %}
          {{ item.content | markdownify | replace: ':memo:', '' | replace: ':tada:', '' | replace: ':sparkles:', '' }}
        {% else %}
          <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ol>
