---
layout: default
---
<section id="about" class="intro" aria-labelledby="name">
  <div class="intro-copy">
    <h1 id="name">{{ site.title | escape }}</h1>
    <p class="affiliation">{{ site.data.profile.role }} · <a href="{{ site.data.profile.organization_url }}">{{ site.data.profile.organization }}</a></p>
    <div class="biography">{{ content }}</div>
    <nav class="profile-links" aria-label="Contact and profiles">
      <a href="mailto:{{ site.email }}">Email</a>
      <a href="{{ site.cv_path | relative_url }}">Curriculum vitae</a>
      <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Google Scholar</a>
      <a href="https://github.com/{{ site.github_username }}">GitHub</a>
      <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}/">LinkedIn</a>
    </nav>
  </div>
  <figure class="portrait">
    <img src="{{ '/assets/img/profile.jpg' | relative_url }}" alt="Portrait of {{ site.title | escape }}" width="160" height="160" fetchpriority="high">
    <figcaption><em>{{ site.data.profile.photo_caption | escape }}</em></figcaption>
  </figure>
</section>

<section id="updates" class="section news-section" aria-labelledby="news-title">
  <div class="section-heading">
    <h2 id="news-title">Recent news</h2>
    <a class="small-link" href="{{ '/news/' | relative_url }}">All news</a>
  </div>
  {% include news.liquid limit=3 %}
</section>

<section id="publications" class="section" aria-labelledby="publications-title">
  <div class="section-heading">
    <h2 id="publications-title">Publications</h2>
    <span class="section-note">Most recent first</span>
  </div>
  <div class="publications">{% bibliography %}</div>
</section>

<div id="experience" class="section two-column">
  <section aria-labelledby="experience-title">
    <h2 id="experience-title">Experience</h2>
    <ol class="records">
      {% for item in site.data.profile.experience %}
        <li>
          <p class="record-date">{{ item.dates }}</p>
          <h3>{{ item.role }}</h3>
          <p class="record-org"><a href="{{ item.url }}">{{ item.organization }}</a></p>
          <p class="record-detail">{{ item.detail }}</p>
        </li>
      {% endfor %}
    </ol>
  </section>
  <section id="education" aria-labelledby="education-title">
    <h2 id="education-title">Education</h2>
    <ol class="records">
      {% for item in site.data.profile.education %}
        <li>
          <p class="record-date">{{ item.dates }}</p>
          <h3>{{ item.degree }}</h3>
          <p class="record-org"><a href="{{ item.url }}">{{ item.organization }}</a></p>
          <p class="record-detail">{{ item.detail }}</p>
        </li>
      {% endfor %}
    </ol>
  </section>
</div>

<div id="service" class="section two-column">
  <section aria-labelledby="service-title">
    <h2 id="service-title">Academic service</h2>
    <h3 class="subheading">Conference reviewing</h3>
    <dl class="service-list">
      {% for item in site.data.profile.reviewing %}
        <div><dt>{{ item.venue }}</dt><dd>{{ item.years }}</dd></div>
      {% endfor %}
    </dl>
    <h3 class="subheading">Journal reviewing</h3>
    <dl class="service-list">
      {% for item in site.data.profile.journal_reviewing %}
        <div><dt>{{ item.venue }}</dt><dd>{{ item.years }}</dd></div>
      {% endfor %}
    </dl>
  </section>
  <section aria-labelledby="honors-title">
    <h2 id="honors-title">Honors &amp; awards</h2>
    <ol class="honors-list">
      {% for item in site.data.profile.honors %}
        <li>
          <span class="record-date">{{ item.year }}</span>
          <div><h3>{{ item.award }}</h3><p class="record-detail">{{ item.organization }}</p></div>
        </li>
      {% endfor %}
    </ol>
  </section>
</div>
