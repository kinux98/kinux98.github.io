---
---
<article class="paper" id="{{ entry.key | escape }}" aria-labelledby="title-{{ entry.key | escape }}">
  {% if entry.preview %}
    <div class="paper-figure">
      <img src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}" alt="Method overview: {{ entry.title | strip_html | escape }}" width="320" height="200" loading="lazy" decoding="async">
    </div>
  {% endif %}
  <div class="paper-body">
    <h3 id="title-{{ entry.key | escape }}">{{ entry.title }}</h3>
    <p class="paper-authors">
      {%- for author in entry.author_array -%}
        {%- unless forloop.first -%}, {% endunless -%}
        {%- assign surname = author.last | remove: '*' | strip -%}
        {%- assign author_name = author.first | append: ' ' | append: surname | strip -%}
        {%- assign author_url = site.data.coauthors[author_name] -%}
        {%- assign author_is_self = false -%}
        {%- if author.first == site.first_name and surname == site.last_name -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
        {%- if author_is_self -%}<strong>{%- endif -%}
        {%- if author_url -%}
          <a href="{{ author_url | escape }}" target="_blank" rel="noopener noreferrer">{{ author_name | escape }}</a>
        {%- else -%}
          {{ author_name | escape }}
        {%- endif -%}
        {%- if author_is_self -%}</strong>{%- endif -%}
        {%- if author.last contains '*' -%}<sup>*</sup>{%- endif -%}
      {%- endfor -%}
    </p>
    <p class="paper-venue">
      {% if entry.booktitle %}{{ entry.booktitle | split: '(' | last | remove: ')' }}{% elsif entry.journal %}{{ entry.journal }}{% endif %} {{ entry.year }}
      {% if entry.note %}<span class="paper-note"> · {{ entry.note }}</span>{% endif %}
    </p>
    <div class="paper-links">
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}{% assign pdf_url = entry.pdf %}{% else %}{% assign pdf_url = entry.pdf | prepend: '/assets/pdf/' | relative_url %}{% endif %}
        <a href="{{ pdf_url }}">{% if pdf_url contains 'openreview.net/forum' %}Paper{% else %}PDF{% endif %}</a>
      {% endif %}
      {% if entry.html %}<a href="{{ entry.html }}">Project page</a>{% endif %}
      {% if entry.code %}<a href="{{ entry.code }}">Code</a>{% endif %}
      {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% endif %}
      {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}">DOI</a>{% endif %}
    </div>
    {% if entry.abstract %}
      <details class="paper-details"><summary>Abstract</summary><p>{{ entry.abstract }}</p></details>
    {% endif %}
    {% if entry.bibtex_show == 'true' or entry.bibtex_show == true %}
      <details class="paper-details"><summary>BibTeX</summary><pre><code>{{ entry.bibtex | escape }}</code></pre></details>
    {% endif %}
  </div>
</article>
