<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% unless page.permalink == '/' %}{{ page.title | default: 'News' | escape }} — {% endunless %}{{ site.title | escape }}</title>
    <meta name="description" content="{{ page.description | default: site.description | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ site.title | escape }}">
    <meta property="og:description" content="{{ site.description | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ '/assets/img/profile.jpg' | absolute_url }}">
    <meta name="color-scheme" content="light dark">
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url }}?v={{ site.time | date: '%Y%m%d%H%M%S' }}">
    <script src="{{ '/assets/js/theme.js' | relative_url }}?v={{ site.time | date: '%Y%m%d%H%M%S' }}"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="site-name" href="{{ '/' | relative_url }}">{{ site.title | escape }}</a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="{{ '/' | relative_url }}#about">About</a>
          <a href="{{ '/' | relative_url }}#publications">Publications</a>
          <a href="{{ '/' | relative_url }}#experience">Background</a>
          <a href="{{ site.cv_path | relative_url }}">CV</a>
          <button id="theme-toggle" type="button" hidden aria-label="Change color theme">Theme</button>
        </nav>
      </div>
    </header>
    <main id="main-content" class="shell" tabindex="-1">{{ content }}</main>
    <footer class="site-footer shell">
      <span>© {{ site.time | date: '%Y' }} {{ site.title | escape }}</span>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </footer>
  </body>
</html>
